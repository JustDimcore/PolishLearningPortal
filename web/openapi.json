{
  "openapi": "3.1.1",
  "info": {
    "title": "Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/version": {
      "get": {
        "tags": [
          "AppInfo"
        ],
        "summary": "API version",
        "operationId": "GetVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lessons": {
      "get": {
        "tags": [
          "Lessons"
        ],
        "summary": "Course outline: lesson groups in order",
        "operationId": "GetCourse",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOutline"
                }
              }
            }
          }
        }
      }
    },
    "/api/lessons/{slug}": {
      "get": {
        "tags": [
          "Lessons"
        ],
        "summary": "A lesson with its sections and neighbours",
        "operationId": "GetLesson",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/cheatsheet": {
      "get": {
        "tags": [
          "CheatSheet"
        ],
        "summary": "The cheat sheet: declension, prepositions, numbers",
        "operationId": "GetCheatSheet",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheatSheetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cheatsheet/search": {
      "get": {
        "tags": [
          "CheatSheet"
        ],
        "summary": "Find a word form in the cheat sheet tables",
        "operationId": "SearchForms",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "A word form, diacritics optional: kobiecie, kobiete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormSearchResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheatSheetResponse": {
        "required": [
          "title",
          "summary",
          "sections"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentSection"
            }
          }
        }
      },
      "ContentBlock": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ContentBlockParagraphBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockNoteBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockBulletListBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockTableBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockExamplesBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockDialogueBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockCardBlock"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "paragraph": "#/components/schemas/ContentBlockParagraphBlock",
            "note": "#/components/schemas/ContentBlockNoteBlock",
            "list": "#/components/schemas/ContentBlockBulletListBlock",
            "table": "#/components/schemas/ContentBlockTableBlock",
            "examples": "#/components/schemas/ContentBlockExamplesBlock",
            "dialogue": "#/components/schemas/ContentBlockDialogueBlock",
            "card": "#/components/schemas/ContentBlockCardBlock"
          }
        }
      },
      "ContentBlockBulletListBlock": {
        "required": [
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "list"
            ],
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLine"
            }
          }
        }
      },
      "ContentBlockCardBlock": {
        "required": [
          "title",
          "caption",
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "card"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "caption": {
            "type": [
              "null",
              "string"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLine"
            }
          }
        }
      },
      "ContentBlockDialogueBlock": {
        "required": [
          "caption",
          "lines"
        ],
        "properties": {
          "type": {
            "enum": [
              "dialogue"
            ],
            "type": "string"
          },
          "caption": {
            "type": [
              "null",
              "string"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DialogueLine"
            }
          }
        }
      },
      "ContentBlockExamplesBlock": {
        "required": [
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "examples"
            ],
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExampleItem"
            }
          }
        }
      },
      "ContentBlockNoteBlock": {
        "required": [
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "note"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "ContentBlockParagraphBlock": {
        "required": [
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "paragraph"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "ContentBlockTableBlock": {
        "required": [
          "header",
          "rows",
          "hasRowHeaders"
        ],
        "properties": {
          "type": {
            "enum": [
              "table"
            ],
            "type": "string"
          },
          "header": {
            "$ref": "#/components/schemas/RichRow"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichRow"
            }
          },
          "hasRowHeaders": {
            "type": "boolean"
          }
        }
      },
      "ContentSection": {
        "required": [
          "id",
          "number",
          "title",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          }
        }
      },
      "CourseGroup": {
        "required": [
          "id",
          "title",
          "lessons"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonLink"
            }
          }
        }
      },
      "CourseOutline": {
        "required": [
          "groups"
        ],
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseGroup"
            }
          }
        }
      },
      "DialogueLine": {
        "required": [
          "text",
          "translation",
          "remark"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "translation": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "remark": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExampleItem": {
        "required": [
          "label",
          "text",
          "translation"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "translation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "FormHit": {
        "required": [
          "form",
          "sectionId",
          "sectionNumber",
          "sectionTitle",
          "block",
          "row",
          "column",
          "rowLabel",
          "columnLabel"
        ],
        "type": "object",
        "properties": {
          "form": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "sectionNumber": {
            "type": "integer",
            "format": "int32"
          },
          "sectionTitle": {
            "type": "string"
          },
          "block": {
            "type": "integer",
            "format": "int32"
          },
          "row": {
            "type": "integer",
            "format": "int32"
          },
          "column": {
            "type": "integer",
            "format": "int32"
          },
          "rowLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "columnLabel": {
            "type": "string"
          }
        }
      },
      "FormSearchResponse": {
        "required": [
          "query",
          "exact",
          "hits"
        ],
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "exact": {
            "type": "boolean"
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormHit"
            }
          }
        }
      },
      "InlineMark": {
        "enum": [
          "bold",
          "italic",
          "ending"
        ]
      },
      "InlineSpan": {
        "required": [
          "text",
          "marks"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineMark"
            }
          }
        }
      },
      "LessonDetail": {
        "required": [
          "slug",
          "number",
          "title",
          "subtitle",
          "summary",
          "minutes",
          "group",
          "sections",
          "previous",
          "next"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "minutes": {
            "type": "integer",
            "format": "int32"
          },
          "group": {
            "$ref": "#/components/schemas/LessonGroupPosition"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentSection"
            }
          },
          "previous": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LessonLink"
              }
            ]
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LessonLink"
              }
            ]
          }
        }
      },
      "LessonGroupPosition": {
        "required": [
          "id",
          "title",
          "position",
          "count"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LessonLink": {
        "required": [
          "slug",
          "number",
          "title",
          "subtitle"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RichLine": {
        "required": [
          "content"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "RichRow": {
        "required": [
          "cells"
        ],
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLine"
            }
          }
        }
      },
      "VersionResponse": {
        "required": [
          "name",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AppInfo"
    },
    {
      "name": "Lessons"
    },
    {
      "name": "CheatSheet"
    }
  ]
}