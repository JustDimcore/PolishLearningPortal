{
  "openapi": "3.1.1",
  "info": {
    "title": "Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/version": {
      "get": {
        "tags": [
          "AppInfo"
        ],
        "summary": "API version",
        "operationId": "GetVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lessons": {
      "get": {
        "tags": [
          "Lessons"
        ],
        "summary": "Course outline: lesson groups in order",
        "operationId": "GetCourse",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOutline"
                }
              }
            }
          }
        }
      }
    },
    "/api/lessons/{slug}": {
      "get": {
        "tags": [
          "Lessons"
        ],
        "summary": "A lesson with its sections and neighbours",
        "operationId": "GetLesson",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/cheatsheet": {
      "get": {
        "tags": [
          "CheatSheet"
        ],
        "summary": "The cheat sheet: declension, prepositions, numbers",
        "operationId": "GetCheatSheet",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheatSheetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cheatsheet/search": {
      "get": {
        "tags": [
          "CheatSheet"
        ],
        "summary": "Find a word form in the cheat sheet tables",
        "operationId": "SearchForms",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "A word form, diacritics optional: kobiecie, kobiete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises": {
      "get": {
        "tags": [
          "Exercises"
        ],
        "summary": "Lessons that have exercises",
        "operationId": "GetExerciseSets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseSetsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises/session": {
      "get": {
        "tags": [
          "Exercises"
        ],
        "summary": "Up to 10 exercises of a lesson, or the given exercises (ids=a,b,c), in random order",
        "operationId": "StartSession",
        "parameters": [
          {
            "name": "lesson",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises/{id}/check": {
      "post": {
        "tags": [
          "Exercises"
        ],
        "summary": "Check answers deterministically; an empty list means \"I don't know\"",
        "operationId": "CheckAnswer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerCheck": {
        "required": [
          "given",
          "expected",
          "verdict"
        ],
        "type": "object",
        "properties": {
          "given": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        }
      },
      "CheatSheetResponse": {
        "required": [
          "title",
          "summary",
          "sections"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentSection"
            }
          }
        }
      },
      "CheckRequest": {
        "required": [
          "answers"
        ],
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CheckResponse": {
        "required": [
          "verdict",
          "answers",
          "explanation"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerCheck"
            }
          },
          "explanation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "ContentBlock": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ContentBlockParagraphBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockNoteBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockBulletListBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockTableBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockExamplesBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockDialogueBlock"
          },
          {
            "$ref": "#/components/schemas/ContentBlockCardBlock"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "paragraph": "#/components/schemas/ContentBlockParagraphBlock",
            "note": "#/components/schemas/ContentBlockNoteBlock",
            "list": "#/components/schemas/ContentBlockBulletListBlock",
            "table": "#/components/schemas/ContentBlockTableBlock",
            "examples": "#/components/schemas/ContentBlockExamplesBlock",
            "dialogue": "#/components/schemas/ContentBlockDialogueBlock",
            "card": "#/components/schemas/ContentBlockCardBlock"
          }
        }
      },
      "ContentBlockBulletListBlock": {
        "required": [
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "list"
            ],
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLine"
            }
          }
        }
      },
      "ContentBlockCardBlock": {
        "required": [
          "title",
          "caption",
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "card"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "caption": {
            "type": [
              "null",
              "string"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichLine"
            }
          }
        }
      },
      "ContentBlockDialogueBlock": {
        "required": [
          "caption",
          "lines"
        ],
        "properties": {
          "type": {
            "enum": [
              "dialogue"
            ],
            "type": "string"
          },
          "caption": {
            "type": [
              "null",
              "string"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DialogueLine"
            }
          }
        }
      },
      "ContentBlockExamplesBlock": {
        "required": [
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "examples"
            ],
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExampleItem"
            }
          }
        }
      },
      "ContentBlockNoteBlock": {
        "required": [
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "note"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "ContentBlockParagraphBlock": {
        "required": [
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "paragraph"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "ContentBlockTableBlock": {
        "required": [
          "header",
          "rows",
          "hasRowHeaders"
        ],
        "properties": {
          "type": {
            "enum": [
              "table"
            ],
            "type": "string"
          },
          "header": {
            "$ref": "#/components/schemas/RichRow"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RichRow"
            }
          },
          "hasRowHeaders": {
            "type": "boolean"
          }
        }
      },
      "ContentSection": {
        "required": [
          "id",
          "number",
          "title",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          }
        }
      },
      "CourseGroup": {
        "required": [
          "id",
          "title",
          "lessons"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonLink"
            }
          }
        }
      },
      "CourseOutline": {
        "required": [
          "groups"
        ],
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseGroup"
            }
          }
        }
      },
      "DeclensionRow": {
        "required": [
          "label",
          "given"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "given": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DialogueLine": {
        "required": [
          "text",
          "translation",
          "remark"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "translation": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "remark": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExampleItem": {
        "required": [
          "label",
          "text",
          "translation"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "translation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "Exercise": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ExerciseFillGapExercise"
          },
          {
            "$ref": "#/components/schemas/ExerciseMultipleChoiceExercise"
          },
          {
            "$ref": "#/components/schemas/ExerciseDeclensionTableExercise"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "fill-gap": "#/components/schemas/ExerciseFillGapExercise",
            "multiple-choice": "#/components/schemas/ExerciseMultipleChoiceExercise",
            "declension-table": "#/components/schemas/ExerciseDeclensionTableExercise"
          }
        }
      },
      "ExerciseDeclensionTableExercise": {
        "required": [
          "word",
          "rows",
          "id",
          "lesson",
          "instruction",
          "translation"
        ],
        "properties": {
          "type": {
            "enum": [
              "declension-table"
            ],
            "type": "string"
          },
          "word": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeclensionRow"
            }
          },
          "id": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "translation": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExerciseFillGapExercise": {
        "required": [
          "sentence",
          "base",
          "id",
          "lesson",
          "instruction",
          "translation"
        ],
        "properties": {
          "type": {
            "enum": [
              "fill-gap"
            ],
            "type": "string"
          },
          "sentence": {
            "$ref": "#/components/schemas/GapText"
          },
          "base": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "translation": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExerciseMultipleChoiceExercise": {
        "required": [
          "prompt",
          "options",
          "id",
          "lesson",
          "instruction",
          "translation"
        ],
        "properties": {
          "type": {
            "enum": [
              "multiple-choice"
            ],
            "type": "string"
          },
          "prompt": {
            "$ref": "#/components/schemas/GapText"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "translation": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExerciseSet": {
        "required": [
          "lesson",
          "number",
          "title",
          "count"
        ],
        "type": "object",
        "properties": {
          "lesson": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ExerciseSetsResponse": {
        "required": [
          "sets"
        ],
        "type": "object",
        "properties": {
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseSet"
            }
          }
        }
      },
      "FormHit": {
        "required": [
          "form",
          "sectionId",
          "sectionNumber",
          "sectionTitle",
          "block",
          "row",
          "column",
          "rowLabel",
          "columnLabel"
        ],
        "type": "object",
        "properties": {
          "form": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "sectionNumber": {
            "type": "integer",
            "format": "int32"
          },
          "sectionTitle": {
            "type": "string"
          },
          "block": {
            "type": "integer",
            "format": "int32"
          },
          "row": {
            "type": "integer",
            "format": "int32"
          },
          "column": {
            "type": "integer",
            "format": "int32"
          },
          "rowLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "columnLabel": {
            "type": "string"
          }
        }
      },
      "FormSearchResponse": {
        "required": [
          "query",
          "exact",
          "hits"
        ],
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "exact": {
            "type": "boolean"
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormHit"
            }
          }
        }
      },
      "GapText": {
        "required": [
          "before",
          "hasGap",
          "after"
        ],
        "type": "object",
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "hasGap": {
            "type": "boolean"
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          }
        }
      },
      "InlineMark": {
        "enum": [
          "bold",
          "italic",
          "ending"
        ]
      },
      "InlineSpan": {
        "required": [
          "text",
          "marks"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineMark"
            }
          }
        }
      },
      "LessonDetail": {
        "required": [
          "slug",
          "number",
          "title",
          "subtitle",
          "summary",
          "minutes",
          "group",
          "sections",
          "previous",
          "next"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InlineSpan"
            }
          },
          "minutes": {
            "type": "integer",
            "format": "int32"
          },
          "group": {
            "$ref": "#/components/schemas/LessonGroupPosition"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentSection"
            }
          },
          "previous": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LessonLink"
              }
            ]
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LessonLink"
              }
            ]
          }
        }
      },
      "LessonGroupPosition": {
        "required": [
          "id",
          "title",
          "position",
          "count"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LessonLink": {
        "required": [
          "slug",
          "number",
          "title",
          "subtitle"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
